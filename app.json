{
  "expo": {
    "name": "Sat Vocab Master",
    "slug": "expo-on-replit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ultrasat.flashcards",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Flashcards to use the camera to capture images and extract underlined words.",
        "NSPhotoLibraryUsageDescription": "Allow Flashcards to access your photo library to upload images for card creation.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ultrasatprep.satflashcards",
      "versionCode": 48
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      },
      "templatePath": "./web/index.html"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "880f4494-b98e-4058-b022-2219a5ff6e7f"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "kocahmet1"
  }
}
